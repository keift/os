[org.gnome.desktop.interface]
accent-color="blue"

[org.gnome.desktop.background]
picture-uri="/usr/share/backgrounds/arthur-shuraev-w8lqmAfvL_k-unsplash.jpg"
picture-uri-dark="/usr/share/backgrounds/arthur-shuraev-w8lqmAfvL_k-unsplash.jpg"

[org.gnome.desktop.wm.preferences]
button-layout="close,minimize,maximize:"

[org.gnome.shell]
enabled-extensions=["appindicatorsupport@rgcjonas.gmail.com", "blur-my-shell@aunetx", "dash-to-dock@micxgx.gmail.com", "ding@rastersoft.com", "logomenu@aryan_k", "os@keift.co"]
favorite-apps=["org.gnome.Software.desktop", "org.gnome.Nautilus.desktop", "org.gnome.TextEditor.desktop", "org.gnome.Ptyxis.desktop", "org.gnome.Epiphany.desktop"]

[org.gnome.shell.extensions.dash-to-dock]
dock-fixed=true
click-action="minimize"

[org.gnome.shell.extensions.logo-menu]
use-custom-icon=true
custom-icon-path="/usr/share/keift-os/logo_menu/icon.png"
menu-button-icon-size="20"