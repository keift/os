{
  "semi": true,
  "singleQuote": true,

  "printWidth": 1000,
  "tabWidth": 2,

  "trailingComma": "none",

  "overrides": [
    {
      "files": ["./src/etc/anaconda/conf.d/*.conf", "./src/etc/dconf/db/distro.d/*", "./src/usr/lib/systemd/system/*", "./src/usr/share/glib-2.0/schemas/*.override"],
      "options": {
        "parser": "ini"
      }
    }
  ],

  "plugins": ["@prettier/plugin-xml", "prettier-plugin-ini", "prettier-plugin-sh", "prettier-plugin-toml"]
}
